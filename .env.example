# ---------------------------------------------------------------------------
# SalesCore environment configuration
# Copy this file to .env and adjust values as needed. .env is git-ignored.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL, via Docker Compose by default) ------------------
POSTGRES_USER=salescore
POSTGRES_PASSWORD=salescore
POSTGRES_DB=salescore
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://salescore:salescore@localhost:5432/salescore

# --- Cache / Redis -----------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Backend (FastAPI) -------------------------------------------------------
APP_NAME=SalesCore
ENV=development
API_V1_PREFIX=/api/v1
JWT_SECRET_KEY=super-secret-development-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=["http://localhost:3000"]
RATE_LIMIT_PER_MINUTE=120
BACKEND_PORT=8000

# --- Optional AI Business Assistant ------------------------------------------
# The app works fully without these. If left empty, a rule-based
# MockAIProvider answers questions using real analytics data.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Frontend (Next.js) -------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
FRONTEND_PORT=3000
